// Cedar POS — main database (PostgreSQL 17)
// Editable at https://dbdiagram.io (paste this file)
// Conventions:
//   - PK: id uuid (time-ordered UUIDv7 generated by the app / device)
//   - Money: numeric(19,4); exchange rates: numeric(19,6); quantities: numeric(18,3)
//   - Times: timestamptz (stored UTC)
//   - Master data has `version` (optimistic locking) and `is_active` (soft delete)
//   - Transactions (sales, returns, payments, movements, cash events) are append-only

Project cedar_pos {
  database_type: 'PostgreSQL'
  Note: 'Cedar POS central database v1 — internship scope'
}

//////////////////////////////////////////////////////////////
// 1. ORGANIZATION & CURRENCY
//////////////////////////////////////////////////////////////

Table currencies {
  code char(3) [pk, note: 'USD, LBP']
  name varchar(50) [not null]
  decimals smallint [not null, note: 'USD=2, LBP=0']
  symbol varchar(5) [not null]
}

Table businesses {
  id uuid [pk]
  name varchar(150) [not null]
  legal_name varchar(200)
  vat_number varchar(50)
  phone varchar(30)
  address varchar(300)
  base_currency char(3) [not null, default: 'USD', ref: > currencies.code]
  secondary_currency char(3) [not null, default: 'LBP', ref: > currencies.code]
  vat_enabled boolean [not null, default: true]
  prices_include_vat boolean [not null, default: true]
  lbp_rounding_step int [not null, default: 1000]
  negative_stock_policy varchar(10) [not null, default: 'WARN', note: 'ALLOW | WARN | BLOCK']
  offline_login_hours int [not null, default: 72]
  rate_stale_hours int [not null, default: 24]
  adjustment_approval_threshold_usd numeric(19,4) [not null, default: 50]
  cash_difference_alert_usd numeric(19,4) [not null, default: 5]
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

Table branches {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  code varchar(5) [not null, note: 'B01 — used in invoice numbers']
  name varchar(100) [not null]
  phone varchar(30)
  address varchar(300)
  receipt_header varchar(500)
  receipt_footer varchar(500)
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (business_id, code) [unique]
  }
}

Table devices {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  device_type varchar(10) [not null, note: 'DESKTOP | MOBILE']
  code varchar(5) [not null, note: 'T01 — used in invoice numbers (desktop)']
  name varchar(100) [not null]
  secret_hash varchar(100) [note: 'bcrypt of device secret']
  activation_code_hash varchar(100)
  activation_expires_at timestamptz
  activated_at timestamptz
  last_seen_at timestamptz
  app_version varchar(20)
  is_active boolean [not null, default: true]
  created_at timestamptz [not null]
  indexes {
    (branch_id, code) [unique]
  }
}

Table cash_registers {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  device_id uuid [unique, ref: - devices.id, note: 'terminal that controls this drawer']
  name varchar(50) [not null]
  is_active boolean [not null, default: true]
}

Table exchange_rates {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  from_currency char(3) [not null, ref: > currencies.code]
  to_currency char(3) [not null, ref: > currencies.code]
  rate numeric(19,6) [not null, note: '1 USD = rate LBP; > 0']
  effective_from timestamptz [not null]
  set_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
  indexes {
    (business_id, from_currency, to_currency, effective_from)
  }
}

Table business_settings {
  business_id uuid [ref: > businesses.id]
  setting_key varchar(80)
  setting_value text
  updated_at timestamptz [not null]
  indexes {
    (business_id, setting_key) [pk]
  }
}

//////////////////////////////////////////////////////////////
// 2. IDENTITY & SECURITY
//////////////////////////////////////////////////////////////

Table permissions {
  code varchar(60) [pk, note: 'e.g. pos.sell']
  module varchar(30) [not null]
  description varchar(200) [not null]
}

Table roles {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(50) [not null]
  is_system boolean [not null, default: false, note: 'default roles cannot be deleted']
  all_branches boolean [not null, default: false]
  max_discount_percent numeric(5,2) [not null, default: 0]
  version int [not null, default: 0]
  indexes {
    (business_id, name) [unique]
  }
}

Table role_permissions {
  role_id uuid [ref: > roles.id]
  permission_code varchar(60) [ref: > permissions.code]
  indexes {
    (role_id, permission_code) [pk]
  }
}

Table users {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  role_id uuid [not null, ref: > roles.id]
  username varchar(50) [not null]
  full_name varchar(100) [not null]
  phone varchar(30)
  email varchar(150)
  password_hash varchar(100) [not null]
  pin_hash varchar(100)
  failed_attempts int [not null, default: 0]
  locked_until timestamptz
  last_login_at timestamptz
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (business_id, username) [unique]
  }
}

Table user_branches {
  user_id uuid [ref: > users.id]
  branch_id uuid [ref: > branches.id]
  indexes {
    (user_id, branch_id) [pk]
  }
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  device_id uuid [not null, ref: > devices.id]
  token_hash varchar(100) [not null, unique]
  expires_at timestamptz [not null]
  revoked_at timestamptz
  created_at timestamptz [not null]
}

Table push_tokens {
  id uuid [pk]
  user_id uuid [not null, ref: > users.id]
  device_id uuid [not null, ref: > devices.id]
  fcm_token varchar(300) [not null, unique]
  platform varchar(10) [not null, note: 'ANDROID | IOS']
  updated_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////
// 3. CATALOG
//////////////////////////////////////////////////////////////

Table tax_rates {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(50) [not null, note: 'VAT 11%, Exempt']
  rate_percent numeric(5,2) [not null]
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
}

Table units {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(30) [not null, note: 'Piece, Kilogram, Litre']
  abbreviation varchar(10) [not null]
  allows_decimal boolean [not null, default: false]
}

Table categories {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  parent_id uuid [ref: > categories.id, note: 'max 2 levels']
  name varchar(100) [not null]
  color char(7) [note: '#RRGGBB for POS buttons']
  sort_order int [not null, default: 0]
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
}

Table products {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  category_id uuid [ref: > categories.id]
  base_unit_id uuid [not null, ref: > units.id]
  tax_rate_id uuid [ref: > tax_rates.id]
  name varchar(150) [not null]
  description varchar(1000)
  brand varchar(80)
  has_variants boolean [not null, default: false]
  track_stock boolean [not null, default: true]
  image_url varchar(300)
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  indexes {
    (business_id, name)
  }
}

Table attributes {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(50) [not null, note: 'Size, Colour']
  indexes {
    (business_id, name) [unique]
  }
}

Table attribute_values {
  id uuid [pk]
  attribute_id uuid [not null, ref: > attributes.id]
  value varchar(50) [not null]
  sort_order int [not null, default: 0]
  indexes {
    (attribute_id, value) [unique]
  }
}

Table product_variants {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  product_id uuid [not null, ref: > products.id]
  sku varchar(50) [not null]
  variant_name varchar(100) [note: 'e.g. M / Navy; null for default variant']
  is_default boolean [not null, default: false]
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
  indexes {
    (business_id, sku) [unique]
  }
}

Table variant_attribute_values {
  variant_id uuid [ref: > product_variants.id]
  attribute_value_id uuid [ref: > attribute_values.id]
  indexes {
    (variant_id, attribute_value_id) [pk]
  }
}

Table packagings {
  id uuid [pk]
  variant_id uuid [not null, ref: > product_variants.id]
  unit_id uuid [not null, ref: > units.id]
  name varchar(50) [not null, note: 'Box of 24']
  quantity_in_base numeric(18,3) [not null, note: '> 1']
  is_active boolean [not null, default: true]
}

Table barcodes {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  variant_id uuid [not null, ref: > product_variants.id]
  packaging_id uuid [ref: > packagings.id, note: 'null = base unit']
  code varchar(50) [not null]
  barcode_type varchar(10) [not null, note: 'EAN13 | EAN8 | UPCA | CODE128 | INTERNAL']
  indexes {
    (business_id, code) [unique]
  }
}

Table variant_prices {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  variant_id uuid [not null, ref: > product_variants.id]
  packaging_id uuid [ref: > packagings.id, note: 'null = base unit']
  branch_id uuid [ref: > branches.id, note: 'null = all branches']
  currency char(3) [not null, ref: > currencies.code]
  amount numeric(19,4) [not null]
  effective_from timestamptz [not null]
  effective_to timestamptz [note: 'null = current']
  set_by uuid [not null, ref: > users.id]
  indexes {
    (variant_id, packaging_id, branch_id, effective_from)
  }
}

//////////////////////////////////////////////////////////////
// 4. INVENTORY
//////////////////////////////////////////////////////////////

Table stock_levels {
  branch_id uuid [ref: > branches.id]
  variant_id uuid [ref: > product_variants.id]
  business_id uuid [not null, ref: > businesses.id]
  quantity_on_hand numeric(18,3) [not null, default: 0, note: '= SUM(stock_movements.quantity)']
  avg_cost_usd numeric(19,4) [not null, default: 0]
  reorder_point numeric(18,3)
  reorder_quantity numeric(18,3)
  last_movement_at timestamptz
  version int [not null, default: 0]
  indexes {
    (branch_id, variant_id) [pk]
  }
}

Table stock_movements {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  variant_id uuid [not null, ref: > product_variants.id]
  movement_type varchar(20) [not null, note: 'OPENING | SALE | SALE_VOID | RETURN | PURCHASE | ADJUSTMENT | TRANSFER_OUT | TRANSFER_IN | COUNT_CORRECTION']
  quantity numeric(18,3) [not null, note: 'signed, base units; never 0']
  unit_cost_usd numeric(19,4) [not null]
  qty_after numeric(18,3) [not null, note: 'running balance snapshot']
  source_type varchar(20) [not null, note: 'SALE | RETURN | PURCHASE | ADJUSTMENT | TRANSFER | COUNT']
  source_id uuid [not null]
  source_line_id uuid
  device_id uuid [ref: > devices.id]
  created_by uuid [not null, ref: > users.id]
  occurred_at timestamptz [not null, note: 'device time']
  recorded_at timestamptz [not null, note: 'server time']
  indexes {
    (branch_id, variant_id, recorded_at)
    (source_type, source_id)
  }
}

Table stock_adjustments {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  reference_no varchar(30) [not null]
  reason varchar(20) [not null, note: 'DAMAGED | EXPIRED | LOST | FOUND | INTERNAL_USE | OTHER']
  note varchar(500)
  status varchar(15) [not null, note: 'PENDING_APPROVAL | POSTED | REJECTED']
  total_value_usd numeric(19,4) [not null]
  device_id uuid [ref: > devices.id]
  created_by uuid [not null, ref: > users.id]
  approved_by uuid [ref: > users.id]
  occurred_at timestamptz [not null]
  posted_at timestamptz
}

Table stock_adjustment_lines {
  id uuid [pk]
  adjustment_id uuid [not null, ref: > stock_adjustments.id]
  variant_id uuid [not null, ref: > product_variants.id]
  quantity numeric(18,3) [not null, note: 'signed: -3 damaged, +1 found']
  unit_cost_usd numeric(19,4) [not null]
}

Table stock_counts {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  reference_no varchar(30) [not null]
  name varchar(100) [not null, note: 'Aisle 3, Full count Nov']
  scope varchar(10) [not null, note: 'FULL | CATEGORY | ADHOC']
  category_id uuid [ref: > categories.id]
  status varchar(15) [not null, note: 'OPEN | SUBMITTED | APPROVED | CANCELLED']
  created_by uuid [not null, ref: > users.id]
  approved_by uuid [ref: > users.id]
  started_at timestamptz [not null]
  submitted_at timestamptz
  approved_at timestamptz
}

Table stock_count_lines {
  id uuid [pk]
  count_id uuid [not null, ref: > stock_counts.id]
  variant_id uuid [not null, ref: > product_variants.id]
  counted_qty numeric(18,3) [not null]
  expected_qty_at_count numeric(18,3) [note: 'system qty when counted (server fills)']
  correction_qty numeric(18,3) [note: 'posted at approval']
  counted_by uuid [not null, ref: > users.id]
  device_id uuid [ref: > devices.id]
  counted_at timestamptz [not null]
  indexes {
    (count_id, variant_id)
  }
}

Table stock_transfers {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  reference_no varchar(30) [not null]
  from_branch_id uuid [not null, ref: > branches.id]
  to_branch_id uuid [not null, ref: > branches.id]
  status varchar(15) [not null, note: 'DRAFT | SENT | RECEIVED | CANCELLED']
  note varchar(500)
  created_by uuid [not null, ref: > users.id]
  sent_by uuid [ref: > users.id]
  received_by uuid [ref: > users.id]
  sent_at timestamptz
  received_at timestamptz
  version int [not null, default: 0]
}

Table stock_transfer_lines {
  id uuid [pk]
  transfer_id uuid [not null, ref: > stock_transfers.id]
  variant_id uuid [not null, ref: > product_variants.id]
  qty_sent numeric(18,3) [not null]
  qty_received numeric(18,3)
  unit_cost_usd numeric(19,4) [not null, note: 'source avg cost at send']
}

//////////////////////////////////////////////////////////////
// 5. PURCHASING
//////////////////////////////////////////////////////////////

Table suppliers {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(150) [not null]
  contact_name varchar(100)
  phone varchar(30)
  email varchar(150)
  address varchar(300)
  default_currency char(3) [not null, default: 'USD', ref: > currencies.code]
  lead_time_days int [not null, default: 3]
  notes varchar(1000)
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
}

Table purchases {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  supplier_id uuid [not null, ref: > suppliers.id]
  reference_no varchar(30) [not null, note: 'PO-B01-00045']
  supplier_invoice_no varchar(50)
  status varchar(15) [not null, note: 'DRAFT | ORDERED | PARTIAL | RECEIVED | CANCELLED']
  currency char(3) [not null, ref: > currencies.code]
  exchange_rate numeric(19,6) [not null]
  subtotal numeric(19,4) [not null]
  tax_total numeric(19,4) [not null]
  total numeric(19,4) [not null, note: 'in purchase currency']
  total_usd numeric(19,4) [not null]
  expected_at date
  ordered_at timestamptz
  received_at timestamptz
  created_by uuid [not null, ref: > users.id]
  version int [not null, default: 0]
  created_at timestamptz [not null]
  indexes {
    (business_id, reference_no) [unique]
  }
}

Table purchase_lines {
  id uuid [pk]
  purchase_id uuid [not null, ref: > purchases.id]
  variant_id uuid [not null, ref: > product_variants.id]
  packaging_id uuid [ref: > packagings.id]
  qty_ordered numeric(18,3) [not null]
  qty_received numeric(18,3) [not null, default: 0]
  unit_cost numeric(19,4) [not null, note: 'per packaging/base, purchase currency']
  unit_cost_usd_base numeric(19,4) [not null, note: 'per base unit in USD']
  tax_rate_percent numeric(5,2) [not null, default: 0]
  line_total numeric(19,4) [not null]
}

Table supplier_payments {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  supplier_id uuid [not null, ref: > suppliers.id]
  purchase_id uuid [ref: > purchases.id]
  cash_session_id uuid [ref: > cash_sessions.id, note: 'if paid from drawer']
  method varchar(15) [not null, note: 'CASH | BANK | CHEQUE | OTHER']
  currency char(3) [not null, ref: > currencies.code]
  amount numeric(19,4) [not null]
  exchange_rate numeric(19,6) [not null]
  amount_usd numeric(19,4) [not null]
  reference varchar(80)
  paid_at timestamptz [not null]
  created_by uuid [not null, ref: > users.id]
}

//////////////////////////////////////////////////////////////
// 6. CUSTOMERS
//////////////////////////////////////////////////////////////

Table customers {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(150) [not null]
  phone varchar(30)
  email varchar(150)
  notes varchar(1000)
  credit_enabled boolean [not null, default: false]
  credit_limit_usd numeric(19,4) [not null, default: 0]
  is_active boolean [not null, default: true]
  version int [not null, default: 0]
  created_at timestamptz [not null]
  indexes {
    (business_id, phone) [unique, note: 'partial index: WHERE phone IS NOT NULL']
  }
}

Table customer_ledger_entries {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  customer_id uuid [not null, ref: > customers.id]
  entry_type varchar(20) [not null, note: 'CREDIT_SALE | PAYMENT | RETURN_CREDIT | STORE_CREDIT | ADJUSTMENT']
  amount_usd numeric(19,4) [not null, note: '+ customer owes more, − owes less']
  source_type varchar(20) [not null]
  source_id uuid [not null]
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null]
  indexes {
    (customer_id, occurred_at)
  }
}

Table customer_payments {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  customer_id uuid [not null, ref: > customers.id]
  branch_id uuid [not null, ref: > branches.id]
  cash_session_id uuid [ref: > cash_sessions.id]
  device_id uuid [ref: > devices.id]
  method varchar(15) [not null, note: 'CASH | CARD | BANK']
  currency char(3) [not null, ref: > currencies.code]
  amount numeric(19,4) [not null]
  exchange_rate numeric(19,6) [not null]
  amount_usd numeric(19,4) [not null]
  received_by uuid [not null, ref: > users.id]
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////
// 7. CASH
//////////////////////////////////////////////////////////////

Table cash_sessions {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  cash_register_id uuid [not null, ref: > cash_registers.id]
  device_id uuid [not null, ref: > devices.id]
  session_no int [not null, note: 'Z number per register']
  status varchar(10) [not null, note: 'OPEN | CLOSED']
  opened_by uuid [not null, ref: > users.id]
  opened_at timestamptz [not null]
  opening_float_usd numeric(19,4) [not null]
  opening_float_lbp numeric(19,4) [not null]
  closed_by uuid [ref: > users.id]
  closed_at timestamptz
  expected_usd numeric(19,4)
  expected_lbp numeric(19,4)
  counted_usd numeric(19,4)
  counted_lbp numeric(19,4)
  difference_usd numeric(19,4)
  difference_lbp numeric(19,4)
  denomination_json text [note: 'optional count by note']
  recorded_at timestamptz [not null]
  indexes {
    (cash_register_id, session_no) [unique]
  }
}

Table cash_movements {
  id uuid [pk]
  cash_session_id uuid [not null, ref: > cash_sessions.id]
  movement_type varchar(10) [not null, note: 'PAY_IN | PAY_OUT | NO_SALE']
  currency char(3) [not null, ref: > currencies.code]
  amount numeric(19,4) [not null, note: '0 for NO_SALE']
  reason varchar(200) [not null]
  expense_id uuid [ref: > expenses.id]
  created_by uuid [not null, ref: > users.id]
  approval_id uuid [ref: > approval_requests.id]
  occurred_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////
// 8. SALES & RETURNS
//////////////////////////////////////////////////////////////

Table sales {
  id uuid [pk, note: 'created on device; idempotency key']
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  device_id uuid [not null, ref: > devices.id]
  cash_session_id uuid [not null, ref: > cash_sessions.id]
  invoice_no varchar(30) [not null, note: 'B01-T02-000123']
  customer_id uuid [ref: > customers.id]
  cashier_id uuid [not null, ref: > users.id]
  status varchar(10) [not null, note: 'COMPLETED | VOIDED']
  exchange_rate numeric(19,6) [not null, note: 'USD→LBP used']
  subtotal_usd numeric(19,4) [not null, note: 'before discounts']
  discount_total_usd numeric(19,4) [not null]
  tax_total_usd numeric(19,4) [not null]
  rounding_usd numeric(19,4) [not null, default: 0]
  total_usd numeric(19,4) [not null]
  total_lbp numeric(19,4) [not null, note: 'rounded to LBP step']
  invoice_discount_type varchar(10) [note: 'PERCENT | AMOUNT']
  invoice_discount_value numeric(19,4)
  discount_approval_id uuid [ref: > approval_requests.id]
  void_reason varchar(200)
  voided_by uuid [ref: > users.id]
  voided_at timestamptz
  note varchar(300)
  occurred_at timestamptz [not null, note: 'device time']
  recorded_at timestamptz [not null, note: 'server time']
  indexes {
    (business_id, invoice_no) [unique]
    (branch_id, occurred_at)
    (cash_session_id)
    (customer_id)
  }
}

Table sale_lines {
  id uuid [pk]
  sale_id uuid [not null, ref: > sales.id]
  line_no int [not null]
  variant_id uuid [not null, ref: > product_variants.id]
  packaging_id uuid [ref: > packagings.id]
  description varchar(200) [not null, note: 'name snapshot']
  quantity numeric(18,3) [not null, note: 'in sold unit']
  base_quantity numeric(18,3) [not null, note: 'quantity × packaging factor']
  unit_price numeric(19,4) [not null, note: 'in price_currency, as sold']
  price_currency char(3) [not null, ref: > currencies.code]
  unit_price_usd numeric(19,4) [not null]
  price_overridden boolean [not null, default: false]
  discount_usd numeric(19,4) [not null, default: 0, note: 'line + share of invoice discount']
  tax_rate_percent numeric(5,2) [not null]
  tax_usd numeric(19,4) [not null]
  line_total_usd numeric(19,4) [not null]
  unit_cost_usd numeric(19,4) [note: 'set by server from avg cost']
  qty_returned numeric(18,3) [not null, default: 0, note: 'maintained by server']
  indexes {
    (sale_id, line_no) [unique]
  }
}

Table sale_payments {
  id uuid [pk]
  sale_id uuid [not null, ref: > sales.id]
  method varchar(15) [not null, note: 'CASH | CARD | CUSTOMER_CREDIT | OTHER']
  is_change boolean [not null, default: false, note: 'change given back (amount negative)']
  currency char(3) [not null, ref: > currencies.code]
  amount numeric(19,4) [not null]
  exchange_rate numeric(19,6) [not null]
  amount_usd numeric(19,4) [not null]
  reference varchar(80) [note: 'card approval / last 4']
}

Table returns {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  device_id uuid [not null, ref: > devices.id]
  cash_session_id uuid [not null, ref: > cash_sessions.id]
  return_no varchar(30) [not null, note: 'R-B01-T02-000017']
  original_sale_id uuid [ref: > sales.id, note: 'null = without receipt']
  customer_id uuid [ref: > customers.id]
  processed_by uuid [not null, ref: > users.id]
  approval_id uuid [ref: > approval_requests.id]
  reason varchar(200) [not null]
  exchange_rate numeric(19,6) [not null]
  total_refund_usd numeric(19,4) [not null]
  occurred_at timestamptz [not null]
  recorded_at timestamptz [not null]
  indexes {
    (business_id, return_no) [unique]
  }
}

Table return_lines {
  id uuid [pk]
  return_id uuid [not null, ref: > returns.id]
  original_sale_line_id uuid [ref: > sale_lines.id]
  variant_id uuid [not null, ref: > product_variants.id]
  quantity numeric(18,3) [not null]
  base_quantity numeric(18,3) [not null]
  refund_usd numeric(19,4) [not null]
  tax_usd numeric(19,4) [not null]
  restock boolean [not null, note: '1 = back to stock']
}

Table return_refunds {
  id uuid [pk]
  return_id uuid [not null, ref: > returns.id]
  method varchar(15) [not null, note: 'CASH | CARD | CUSTOMER_CREDIT | STORE_CREDIT']
  currency char(3) [not null, ref: > currencies.code]
  amount numeric(19,4) [not null]
  exchange_rate numeric(19,6) [not null]
  amount_usd numeric(19,4) [not null]
}

//////////////////////////////////////////////////////////////
// 9. EXPENSES
//////////////////////////////////////////////////////////////

Table expense_categories {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  name varchar(80) [not null, note: 'Rent, Electricity, Generator, Salaries']
  is_active boolean [not null, default: true]
}

Table expenses {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  category_id uuid [not null, ref: > expense_categories.id]
  description varchar(300) [not null]
  currency char(3) [not null, ref: > currencies.code]
  amount numeric(19,4) [not null]
  exchange_rate numeric(19,6) [not null]
  amount_usd numeric(19,4) [not null]
  paid_from_drawer boolean [not null, default: false]
  cash_session_id uuid [ref: > cash_sessions.id]
  expense_date date [not null]
  created_by uuid [not null, ref: > users.id]
  created_at timestamptz [not null]
}

//////////////////////////////////////////////////////////////
// 10. APPROVALS, NOTIFICATIONS
//////////////////////////////////////////////////////////////

Table approval_requests {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [not null, ref: > branches.id]
  device_id uuid [not null, ref: > devices.id]
  request_type varchar(30) [not null, note: 'DISCOUNT_OVER_LIMIT | PRICE_OVERRIDE | VOID_SALE | RETURN_NO_RECEIPT | CREDIT_OVER_LIMIT | STOCK_ADJUSTMENT | PAY_OUT | NO_SALE']
  payload_json text [not null, note: 'what is being approved']
  status varchar(10) [not null, note: 'PENDING | APPROVED | REJECTED | EXPIRED']
  channel varchar(10) [not null, note: 'PIN | MOBILE']
  requested_by uuid [not null, ref: > users.id]
  decided_by uuid [ref: > users.id]
  decision_note varchar(200)
  requested_at timestamptz [not null]
  decided_at timestamptz
  expires_at timestamptz [not null]
  indexes {
    (business_id, status, requested_at)
  }
}

Table notifications {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  user_id uuid [not null, ref: > users.id]
  notif_type varchar(30) [not null, note: 'APPROVAL_REQUEST | LOW_STOCK | CASH_DIFFERENCE | SYNC_ISSUE | DEVICE_OFFLINE | DAILY_SUMMARY | SUSPICIOUS_ACTIVITY | RECEIPT_DIFFERENCE | RATE_CHANGED']
  title varchar(100) [not null]
  body varchar(300) [not null]
  data_json text
  read_at timestamptz
  pushed_at timestamptz
  created_at timestamptz [not null]
  indexes {
    (user_id, created_at)
  }
}

//////////////////////////////////////////////////////////////
// 11. SYNC
//////////////////////////////////////////////////////////////

Table processed_operations {
  operation_id uuid [pk, note: 'outbox id from device']
  business_id uuid [not null, ref: > businesses.id]
  device_id uuid [not null, ref: > devices.id]
  entity_type varchar(30) [not null]
  entity_id uuid [not null]
  result varchar(10) [not null, note: 'APPLIED | FLAGGED | REJECTED']
  response_json text
  device_time timestamptz
  received_at timestamptz [not null]
}

Table change_log {
  seq bigint [pk, increment, note: 'bigint identity — global ordering for pull']
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [ref: > branches.id, note: 'null = all branches']
  entity_type varchar(30) [not null]
  entity_id varchar(80) [not null, note: 'uuid or composite key']
  operation varchar(10) [not null, note: 'UPSERT | DELETE']
  changed_at timestamptz [not null]
  indexes {
    (business_id, seq)
  }
}

Table device_sync_state {
  device_id uuid [pk, ref: - devices.id]
  last_pulled_seq bigint [not null, default: 0]
  last_push_at timestamptz
  last_pull_at timestamptz
  pending_reported int [not null, default: 0, note: 'outbox size reported by device']
  clock_skew_seconds int
}

Table sync_issues {
  id uuid [pk]
  business_id uuid [not null, ref: > businesses.id]
  device_id uuid [not null, ref: > devices.id]
  operation_id uuid [ref: > processed_operations.operation_id]
  issue_type varchar(30) [not null, note: 'OVER_RETURN | NEGATIVE_STOCK | CLOCK_SKEW | INACTIVE_PRODUCT | SESSION_MISMATCH | TOTAL_MISMATCH | REJECTED']
  severity varchar(10) [not null, note: 'INFO | WARNING | ERROR']
  message varchar(500) [not null]
  status varchar(10) [not null, note: 'OPEN | RESOLVED']
  resolved_by uuid [ref: > users.id]
  resolution_note varchar(300)
  created_at timestamptz [not null]
  resolved_at timestamptz
}

//////////////////////////////////////////////////////////////
// 12. AUDIT
//////////////////////////////////////////////////////////////

Table audit_logs {
  id bigint [pk, increment]
  business_id uuid [not null, ref: > businesses.id]
  branch_id uuid [ref: > branches.id]
  user_id uuid [ref: > users.id]
  device_id uuid [ref: > devices.id]
  action varchar(50) [not null, note: 'LOGIN_FAILED, PRICE_CHANGED, SALE_VOIDED …']
  entity_type varchar(30)
  entity_id varchar(80)
  old_values_json text
  new_values_json text
  reason varchar(300)
  ip_address varchar(45)
  occurred_at timestamptz [not null]
  prev_hash char(64) [note: 'Could: tamper evidence']
  entry_hash char(64)
  indexes {
    (business_id, occurred_at)
    (entity_type, entity_id)
  }
}
