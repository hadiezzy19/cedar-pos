erDiagram
  categories ||--o{ categories : "parent of"
  categories ||--o{ products : groups
  units ||--o{ products : "base unit"
  tax_rates ||--o{ products : taxes
  products ||--|{ product_variants : "has (≥1)"
  attributes ||--o{ attribute_values : has
  product_variants ||--o{ variant_attribute_values : "described by"
  attribute_values ||--o{ variant_attribute_values : "used in"
  product_variants ||--o{ packagings : "packed as"
  units ||--o{ packagings : unit
  product_variants ||--o{ barcodes : identified
  packagings |o--o{ barcodes : identified
  product_variants ||--o{ variant_prices : priced
  packagings |o--o{ variant_prices : priced
  branches |o--o{ variant_prices : "override for"

  products {
    uuid id PK
    uuid category_id FK
    uuid base_unit_id FK
    uuid tax_rate_id FK
    string name
    bool has_variants
    bool track_stock
  }
  product_variants {
    uuid id PK
    uuid product_id FK
    string sku UK
    string variant_name
    bool is_default
  }
  packagings {
    uuid id PK
    uuid variant_id FK
    uuid unit_id FK
    decimal quantity_in_base
  }
  barcodes {
    uuid id PK
    uuid variant_id FK
    uuid packaging_id FK
    string code UK
  }
  variant_prices {
    uuid id PK
    uuid variant_id FK
    uuid packaging_id FK
    uuid branch_id FK
    char currency FK
    decimal amount
    datetime effective_from
    datetime effective_to
  }
  categories {
    uuid id PK
    uuid parent_id FK
    string name
  }
  attributes {
    uuid id PK
    string name
  }
  attribute_values {
    uuid id PK
    uuid attribute_id FK
    string value
  }
  variant_attribute_values {
    uuid variant_id PK
    uuid attribute_value_id PK
  }
  units {
    uuid id PK
    string name
    bool allows_decimal
  }
  tax_rates {
    uuid id PK
    decimal rate_percent
  }
